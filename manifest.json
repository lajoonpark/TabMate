{
  "manifest_version": 3,
  "name": "TabMate",
  "description": "Organise, categorise, and tidy your browser tabs with ease.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["tabs", "storage", "tabGroups", "scripting"],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "TabMate",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "organise-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Organise tabs into groups"
    },
    "delete-duplicates": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Delete duplicate tabs"
    },
    "save-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save current tab to default board"
    },
    "open-preset-1": {
      "description": "Open preset slot 1"
    },
    "save-to-board-1": {
      "description": "Save current tab to board slot 1"
    },
    "save-to-board-2": {
      "description": "Save current tab to board slot 2"
    },
    "save-to-board-3": {
      "description": "Save current tab to board slot 3"
    },
    "toggle-popups": {
      "description": "Toggle pop-up notifications"
    }
  }
}
